@{
    ViewData["Title"] = "Panel administratora";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold"><i class="bi bi-speedometer2 text-success me-3"></i>Panel administratora</h1>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card text-center shadow-sm border-0 bg-success text-white">
            <div class="card-body py-4">
                <i class="bi bi-grid-3x3-gap display-5 mb-2"></i>
                <h2 class="fw-bold">@ViewBag.TotalCourts</h2>
                <p class="mb-0">Kortów łącznie</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm border-0 bg-primary text-white">
            <div class="card-body py-4">
                <i class="bi bi-calendar-check display-5 mb-2"></i>
                <h2 class="fw-bold">@ViewBag.ActiveReservations</h2>
                <p class="mb-0">Aktywnych rezerwacji</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm border-0 bg-info text-white">
            <div class="card-body py-4">
                <i class="bi bi-calendar3 display-5 mb-2"></i>
                <h2 class="fw-bold">@ViewBag.TotalReservations</h2>
                <p class="mb-0">Rezerwacji łącznie</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm border-0 bg-warning text-dark">
            <div class="card-body py-4">
                <i class="bi bi-cash-coin display-5 mb-2"></i>
                <h2 class="fw-bold">@ViewBag.Revenue?.ToString("F0") zł</h2>
                <p class="mb-0">Przychód łączny</p>
            </div>
        </div>
    </div>
</div>

<h4 class="fw-bold mb-3">Zarządzanie systemem</h4>
<div class="row g-3">
    <div class="col-md-4">
        <a asp-action="Courts" class="card shadow-sm text-decoration-none h-100 text-dark">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-grid-3x3-gap-fill display-6 text-success"></i>
                <div>
                    <h6 class="fw-bold mb-0">Zarządzaj kortami</h6>
                    <small class="text-muted">Dodaj, edytuj, usuń (CRUD)</small>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-action="Reservations" class="card shadow-sm text-decoration-none h-100 text-dark">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-calendar2-week-fill display-6 text-primary"></i>
                <div>
                    <h6 class="fw-bold mb-0">Rezerwacje</h6>
                    <small class="text-muted">Przeglądaj wszystkie wpisy</small>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-action="Messages" class="card shadow-sm text-decoration-none h-100 text-dark border-start border-danger border-4">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-envelope-paper-fill display-6 text-danger"></i>
                <div>
                    <h6 class="fw-bold mb-0">Wiadomości</h6>
                    <small class="text-muted">Pytania od użytkowników</small>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-action="Users" class="card shadow-sm text-decoration-none h-100 text-dark border-start border-info border-4">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-people-fill display-6 text-info"></i>
                <div>
                    <h6 class="fw-bold mb-0">Użytkownicy</h6>
                    <small class="text-muted">Lista zarejestrowanych osób</small>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-action="CourtCreate" class="card shadow-sm text-decoration-none h-100 text-dark">
            <div class="card-body d-flex align-items-center gap-3">
                <i class="bi bi-plus-circle-fill display-6 text-warning"></i>
                <div>
                    <h6 class="fw-bold mb-0">Nowy kort</h6>
                    <small class="text-muted">Dodaj obiekt do bazy</small>
                </div>
            </div>
        </a>
    </div>
</div>