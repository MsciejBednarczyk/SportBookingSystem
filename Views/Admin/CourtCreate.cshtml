@model SportBookingSystem.Models.Court

@{
    ViewData["Title"] = "Dodaj nowy kort";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Panel admina</a></li>
        <li class="breadcrumb-item"><a asp-action="Courts">Korty</a></li>
        <li class="breadcrumb-item active">Dodaj kort</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Dodaj nowy kort</h5>
            </div>
            <div class="card-body">
                <form asp-action="CourtCreate" method="post">
                    @Html.AntiForgeryToken()
                    @await Html.PartialAsync("_CourtForm", Model)
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle me-1"></i>Dodaj kort
                        </button>
                        <a asp-action="Courts" class="btn btn-outline-secondary">Anuluj</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
