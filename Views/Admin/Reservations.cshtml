@model IEnumerable<SportBookingSystem.Models.Reservation>

@{
    ViewData["Title"] = "Wszystkie rezerwacje";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold"><i class="bi bi-calendar2-week-fill text-success me-3"></i>Wszystkie rezerwacje</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Wróć do dashboardu
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-success">
                    <tr>
                        <th>ID</th>
                        <th>Kort</th>
                        <th>Użytkownik</th>
                        <th>Data</th>
                        <th>Godziny</th>
                        <th>Cena</th>
                        <th>Status</th>
                        <th class="text-center">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="text-muted small">#@r.Id</td>
                            <td class="fw-semibold">@r.Court?.Name</td>
                            <td>
                                @r.User?.Email
                                <br /><small class="text-muted">@r.User?.FullName</small>
                            </td>
                            <td>@r.ReservationDate.ToString("dd.MM.yyyy")</td>
                            <td>@r.StartTime.ToString(@"hh\:mm") – @r.EndTime.ToString(@"hh\:mm")</td>
                            <td class="fw-bold text-success">@r.TotalPrice.ToString("F2") zł</td>
                            <td>
                                @switch (r.Status)
                                {
                                    case SportBookingSystem.Models.ReservationStatus.Active:
                                        <span class="badge bg-success">Aktywna</span>
                                        break;
                                    case SportBookingSystem.Models.ReservationStatus.Cancelled:
                                        <span class="badge bg-danger">Anulowana</span>
                                        break;
                                    case SportBookingSystem.Models.ReservationStatus.Completed:
                                        <span class="badge bg-secondary">Zakończona</span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                <form asp-action="ReservationDelete" asp-route-id="@r.Id" method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Czy na pewno chcesz trwale usunąć rezerwację #@r.Id?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
