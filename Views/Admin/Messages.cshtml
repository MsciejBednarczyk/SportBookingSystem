@using SportBookingSystem.Models

@model IEnumerable<SportBookingSystem.Models.ContactMessage>
@{
    ViewData["Title"] = "Wiadomości";
}

<div class="container-fluid">
    <h2 class="fw-bold mb-4"><i class="bi bi-envelope-paper text-danger me-2"></i>Wiadomości kontaktowe</h2>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Imię i nazwisko</th>
                        <th>Wiadomość</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td class="ps-4"><strong>@m.Name</strong></td>
                            <td class="text-muted">@m.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary px-4">Powrót do panelu</a>
    </div>
</div>
