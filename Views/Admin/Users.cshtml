@model IEnumerable<SportBookingSystem.Models.ApplicationUser>
@{
    ViewData["Title"] = "Użytkownicy";
}

<div class="container-fluid">
    <h2 class="fw-bold mb-4"><i class="bi bi-people text-info me-2"></i>Zarejestrowani użytkownicy</h2>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">E-mail / Login</th>
                        <th>Imię i Nazwisko</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="ps-4">@u.Email</td>
                            <td>@u.FullName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary px-4">Powrót do panelu</a>
    </div>
</div>
