@model IEnumerable<SportBookingSystem.Models.Court>

@{
    ViewData["Title"] = "Dostępne korty";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold"><i class="bi bi-grid-3x3-gap-fill text-success me-3"></i>Dostępne korty</h1>
</div>

<div class="row g-4">
    @foreach (var court in Model)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm court-card">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <span class="fw-bold">@court.Name</span>
                    @if (court.IsIndoor)
                    {
                        <span class="badge bg-light text-dark"><i class="bi bi-house me-1"></i>Kryty</span>
                    }
                    else
                    {
                        <span class="badge bg-light text-dark"><i class="bi bi-sun me-1"></i>Otwarty</span>
                    }
                </div>
                <div class="card-body">
                    <p class="text-muted">@court.Description</p>
                    <ul class="list-unstyled">
                        <li class="mb-1"><i class="bi bi-layers me-2 text-success"></i><strong>Nawierzchnia:</strong> @court.Surface</li>
                        <li class="mb-1"><i class="bi bi-currency-exchange me-2 text-success"></i><strong>Cena:</strong> @court.PricePerHour zł / godz.</li>
                    </ul>
                </div>
                <div class="card-footer bg-transparent d-flex gap-2">
                    <a asp-action="Details" asp-route-id="@court.Id" class="btn btn-outline-success flex-fill">
                        <i class="bi bi-info-circle me-1"></i>Szczegóły
                    </a>
                    @if (User.Identity!.IsAuthenticated)
                    {
                        <a asp-controller="Reservations" asp-action="Create" asp-route-courtId="@court.Id"
                           class="btn btn-success flex-fill">
                            <i class="bi bi-calendar-plus me-1"></i>Zarezerwuj
                        </a>
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-secondary flex-fill">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Zaloguj
                        </a>
                    }
                </div>
            </div>
        </div>
    }
</div>

