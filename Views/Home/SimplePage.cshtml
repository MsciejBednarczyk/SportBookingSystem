@{
    ViewData["Title"] = "Kontakt";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white p-4 text-center">
                    <h2 class="mb-0"><i class="bi bi-envelope-fill me-2"></i>Napisz do nas</h2>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">
                        Masz pytania dotyczące rezerwacji kortów lub funkcjonowania obiektu?
                        Skorzystaj z poniższego formularza.
                    </p>

                    <form asp-action="SimplePage" method="post">
                        @* ASP.NET Core Validation Summary - pokaże ewentualne błędy *@
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Twoje Imię</label>
                            <input type="text" name="name" class="form-control form-control-lg"
                                   placeholder="Wpisz swoje imię i nazwisko" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Wiadomość</label>
                            <textarea name="message" class="form-control" rows="5"
                                      placeholder="W czym możemy pomóc?" required></textarea>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success btn-lg shadow-sm">
                                Wyślij zapytanie
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="mt-4 text-center text-muted">
                <small><i class="bi bi-info-circle me-1"></i> Odpowiemy na Twoją wiadomość w ciągu 24h.</small>
            </div>
        </div>
    </div>
</div>